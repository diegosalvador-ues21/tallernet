digraph G {
  graph [fontname="Carlito", fontsize=11, rankdir=TB, nodesep=0.35, ranksep=0.55, bgcolor="white", pad=0.2];
  node [shape=plaintext, fontname="Carlito", fontsize=10, fontcolor="#212121"];
  edge [fontname="Carlito", fontsize=9, color="#616161", fontcolor="#616161"];
  AD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>AgendaDiaria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ <U>MINUTOS_FRANJA = 30</U><BR/>- sede: Sede<BR/>- fecha: LocalDate<BR/>- <B>franjas: Turno[ ]</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ AgendaDiaria(Sede, LocalDate, List&lt;Turno&gt;)<BR/>+ primerHuecoLibre(min, desde): Optional&lt;LocalTime&gt;<BR/>+ horariosDisponibles(min): List&lt;LocalTime&gt;<BR/>+ contarOcupadas(): int<BR/>+ getFranjas(): Turno[ ]  (copia)</TD></TR></TABLE>>];
  RS [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>ReporteSemanal</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ <U>DIAS: String[ ]</U><BR/>- <B>turnosPorDia: int[6]</B><BR/>- <B>minutosPorDia: int[6]</B><BR/>- <B>ingresoPorDia: BigDecimal[6]</B><BR/>- <B>turnosPorSedeYDia: int[ ][ ]</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ReporteSemanal(LocalDate, List&lt;Sede&gt;, List&lt;Turno&gt;)<BR/>+ getDiaDeMayorCarga(): int<BR/>+ diasSinTurnos(): List&lt;String&gt;<BR/>+ getTurnosPorDia(): int[ ]  (copia)</TD></TR></TABLE>>];
  EX [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I>Exportador&lt;T&gt;</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ nombreArchivo(T): String<BR/>+ exportar(T, Path): Path</TD></TR></TABLE>>];
  EC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I>ExportadorCsv&lt;T&gt;</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ <I>final</I> exportar(T, Path): Path<BR/># <I>encabezado(): String[ ]</I><BR/># <I>filas(T): List&lt;String[ ]&gt;</I></TD></TR></TABLE>>];
  AC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>AgendaCsv</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># encabezado(), filas(AgendaDiaria)</TD></TR></TABLE>>];
  RT [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>ReporteSemanalTxt</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ exportar(ReporteSemanal, Path)</TD></TR></TABLE>>];
  IC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>ImportadorClientesCsv</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ importar(Path): Resultado<BR/>«interface» RegistroCliente</TD></TR></TABLE>>];
  RO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I>RegistroOperaciones</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(operacion, detalle)<BR/>+ <U>NINGUNO</U></TD></TR></TABLE>>];
  BI [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>Bitacora</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- archivo: Path</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ registrar(...)<BR/>+ ultimas(n): List&lt;String&gt;  (búfer String[ ])</TD></TR></TABLE>>];
  ACt [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«control»</FONT><BR/><B>ArchivoControlador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ exportarAgenda(sede, fecha): Path<BR/>+ exportarReporteSemanal(fecha): Path<BR/>+ importarClientes(ruta): Resultado</TD></TR></TABLE>>];
  EC -> EX [arrowhead=empty, style=dashed]; AC -> EC [arrowhead=empty]; RT -> EX [arrowhead=empty, style=dashed]; BI -> RO [arrowhead=empty, style=dashed];
  ACt -> EX [arrowhead=open, label=" usa"]; ACt -> IC [arrowhead=open];
  AC -> AD [arrowhead=open, style=dashed]; RT -> RS [arrowhead=open, style=dashed];
}
