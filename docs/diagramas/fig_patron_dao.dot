digraph G {
  graph [fontname="Carlito", fontsize=11, rankdir=TB, nodesep=0.35, ranksep=0.55, bgcolor="white", pad=0.2];
  node [shape=plaintext, fontname="Carlito", fontsize=10, fontcolor="#212121"];
  edge [fontname="Carlito", fontsize=9, color="#616161", fontcolor="#616161"];
  Ctrl [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«control»</FONT><BR/><B>ClienteControlador</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- clientes: Dao&lt;Cliente, Integer&gt;<BR/>+ actualizarContacto(id, tel, email): Cliente<BR/>+ registrarCliente(...): Cliente</TD></TR></TABLE>>];
  Dao [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I>Dao&lt;T, K&gt;</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ insertar(T): K<BR/>+ listar(): List&lt;T&gt;<BR/>+ buscarPorId(K): Optional&lt;T&gt;<BR/>+ <I>default</I> actualizar(T): void</TD></TR></TABLE>>];
  TR [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I>TurnoRepositorio</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ insertarSiDisponible(Turno): int<BR/>+ cambiarEstado(id, esperado, nuevo)<BR/>+ listarAgenda(sede, fecha)<BR/>+ listarEntre(desde, hasta)</TD></TR></TABLE>>];
  VR [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I>VehiculoRepositorio</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buscarPorPatente(String)<BR/>+ listarOrdenadoPorPatente()</TD></TR></TABLE>>];
  DJ [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I>DaoJdbc</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># abrir(): Connection<BR/># consultar(accion, sql, ParametrosSentencia, MapeadorFila&lt;T&gt;): List&lt;T&gt;<BR/># consultarUno(...): Optional&lt;T&gt;<BR/># actualizar(accion, sql, ParametrosSentencia, dup): int<BR/># <U>mapearSede / mapearCliente / mapearVehiculo / mapearServicio</U></TD></TR></TABLE>>];
  MF [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I>MapeadorFila&lt;T&gt;</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ mapear(ResultSet): T</TD></TR></TABLE>>];
  PS [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«interface»</FONT><BR/><I>ParametrosSentencia</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ asignar(PreparedStatement)</TD></TR></TABLE>>];
  CD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>ClienteDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ listar() / buscarPorId()<BR/>+ actualizar(Cliente)</TD></TR></TABLE>>];
  SD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>ServicioDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ actualizar(Servicio)</TD></TR></TABLE>>];
  TD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>TurnoDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ insertarSiDisponible(Turno)<BR/>- insertarUnaVez(Turno)<BR/>- <U>mapearTurno(ResultSet)</U></TD></TR></TABLE>>];
  VD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>VehiculoDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buscarPorPatente(String)</TD></TR></TABLE>>];
  OD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><B>SedeDAO, EmpleadoDAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(heredan actualizar por defecto)</TD></TR></TABLE>>];
  CBD [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«singleton»</FONT><BR/><B>ConexionBD</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- <U>instancia: ConexionBD</U><BR/>- url, usuario, clave</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ <U>getInstancia(): ConexionBD</U><BR/>+ getConexion(): Connection<BR/>+ diagnosticar(): InfoConexion</TD></TR></TABLE>>];
  TSE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«utility»</FONT><BR/><B>TraductorSQLException</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ <U>traducir(accion, SQLException, dup): TallerNetException</U><BR/>+ <U>tecnica(accion, SQLException)</U><BR/>+ <U>esDeConexion(e)</U> / <U>esReintentable(e)</U></TD></TR></TABLE>>];
  Ctrl -> Dao [arrowhead=open, label=" usa"];
  TR -> Dao [arrowhead=empty]; VR -> Dao [arrowhead=empty];
  CD -> DJ [arrowhead=empty]; SD -> DJ [arrowhead=empty]; TD -> DJ [arrowhead=empty]; VD -> DJ [arrowhead=empty]; OD -> DJ [arrowhead=empty];
  CD -> Dao [arrowhead=empty, style=dashed]; SD -> Dao [arrowhead=empty, style=dashed]; OD -> Dao [arrowhead=empty, style=dashed]; TD -> TR [arrowhead=empty, style=dashed]; VD -> VR [arrowhead=empty, style=dashed];
  DJ -> MF [arrowhead=open, style=dashed, label=" paso variable"]; DJ -> PS [arrowhead=open, style=dashed];
  DJ -> CBD [arrowhead=open, label=" abrir()"]; DJ -> TSE [arrowhead=open, style=dashed, label=" traduce errores"];
  {rank=same; TR; VR; Dao}
  {rank=same; CD; SD; TD; VD; OD}
}
