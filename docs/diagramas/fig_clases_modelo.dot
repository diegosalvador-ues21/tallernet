digraph G {
  graph [fontname="Carlito", fontsize=11, rankdir=LR, nodesep=0.35, ranksep=0.55, bgcolor="white", pad=0.2];
  node [shape=plaintext, fontname="Carlito", fontsize=10, fontcolor="#212121"];
  edge [fontname="Carlito", fontsize=9, color="#616161", fontcolor="#616161"];
  Persona [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I>Persona</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR/>- nombre: String<BR/>- apellido: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># Persona(id, nombre, apellido)<BR/>+ <I>getDescripcionRol(): String</I><BR/>+ <I>getDatoDeContacto(): String</I><BR/>+ getNombreCompleto(): String<BR/>+ setNombre(String) throws DatoInvalidoException<BR/>+ toString(): String</TD></TR></TABLE>>];
  Cliente [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Cliente</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- telefono: String<BR/>- email: String<BR/>- fechaAlta: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Cliente(nombre, apellido, telefono, email)<BR/>+ getDescripcionRol(): String<BR/>+ getDatoDeContacto(): String<BR/>+ setTelefono(String)<BR/>+ setEmail(String)</TD></TR></TABLE>>];
  Empleado [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Empleado</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- sedeId: int<BR/>- rol: Rol<BR/>- activo: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Empleado(id, sedeId, nombre, apellido, rol, activo)<BR/>+ puedeRegistrarTurnos(): boolean<BR/>+ getDescripcionRol(): String<BR/>+ getDatoDeContacto(): String</TD></TR></TABLE>>];
  Servicio [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#fff8e1" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«abstract»</FONT><BR/><I>Servicio</I></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR/>- descripcion: String<BR/>- precioBase: BigDecimal<BR/>- duracionMin: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ <U>crear(id, desc, precio, min, Integer km): Servicio</U><BR/>+ <I>calcularProximoServiceKm(int): OptionalInt</I><BR/>+ <I>describirIntervalo(): String</I><BR/>+ <I>getKmServicio(): Integer</I></TD></TR></TABLE>>];
  SPK [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>ServicioPorKilometraje</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- kmServicio: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularProximoServiceKm(int): OptionalInt<BR/>+ describirIntervalo(): String</TD></TR></TABLE>>];
  SG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>ServicioGeneral</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ calcularProximoServiceKm(int): OptionalInt<BR/>+ describirIntervalo(): String</TD></TR></TABLE>>];
  Turno [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Turno</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR/>- fechaHora: LocalDateTime<BR/>- estado: EstadoTurno<BR/>- observaciones: String<BR/>- empleadoId: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Turno(sede, vehiculo, servicio, empleadoId, fechaHora, obs)<BR/>+ getFin(): LocalDateTime<BR/>+ seSuperponeCon(Turno): boolean<BR/>+ cancelar(): void<BR/>+ getFranja(): String</TD></TR></TABLE>>];
  Sede [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Sede</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR/>- nombre: String<BR/>- horaApertura: LocalTime<BR/>- horaCierre: LocalTime<BR/>- activa: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ contieneIntervalo(LocalTime, LocalTime): boolean<BR/>+ getFranja(): String</TD></TR></TABLE>>];
  Vehiculo [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«entity»</FONT><BR/><B>Vehiculo</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: int<BR/>- clienteId: int<BR/>- patente: String<BR/>- marca, modelo: String<BR/>- anio: int<BR/>- kmAlta: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Vehiculo(clienteId, patente, marca, modelo, anio, km)<BR/>+ setPatente(String)<BR/>+ setKmAlta(int) throws DatoInvalidoException</TD></TR></TABLE>>];
  EstadoTurno [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>EstadoTurno</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CONFIRMADO<BR/>CANCELADO<BR/>ATENDIDO<BR/>+ ocupaAgenda(): boolean</TD></TR></TABLE>>];
  Rol [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white" COLOR="#9e9e9e"><TR><TD BGCOLOR="#004d40"><FONT COLOR="white"><FONT POINT-SIZE="9">«enumeration»</FONT><BR/><B>Rol</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">RECEPCIONISTA<BR/>MECANICO<BR/>ENCARGADO_REPUESTOS<BR/>ADMINISTRADOR</TD></TR></TABLE>>];
  Persona -> Cliente [arrowtail=empty, dir=back];
  Persona -> Empleado [arrowtail=empty, dir=back];
  Servicio -> SPK [arrowtail=empty, dir=back];
  Servicio -> SG [arrowtail=empty, dir=back];
  Turno -> Sede [arrowhead=vee, label=" 1"];
  Turno -> Vehiculo [arrowhead=vee, label=" 1"];
  Turno -> Servicio [arrowhead=vee, label=" 1", constraint=false];
  Turno -> EstadoTurno [arrowhead=vee, style=dashed];
  Empleado -> Rol [arrowhead=vee, style=dashed, constraint=false];
  Cliente -> Vehiculo [arrowtail=odiamond, dir=back, arrowhead=none, label=" 0..*"];
}
